# Copy this file to `.env` and fill in your real DSNs.
# `.env` is gitignored — never commit real DSNs.
#
# If either of these is unset, the demo still runs locally and the
# validation endpoint still returns 5/5 PASSED, but no envelopes are
# shipped to Sentry — only the in-memory CaptureTransport runs.

SENTRY_PRIMARY_DSN=https://<public_key>@<host>/<primary_project_id>
SENTRY_CRITICAL_DSN=https://<public_key>@<host>/<critical_project_id>
